<Window x:Class="OpenSynapse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSynapse" Height="820" Width="1180" MinHeight="700" MinWidth="1000"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#090B0A" Foreground="#F4F4F4" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#171A18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44D62C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171A18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B514D"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#171A18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#3C423E"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Foreground" Value="#44D62C"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A7ADA9"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#070908" BorderBrush="#202522" BorderThickness="0,0,1,0">
            <StackPanel Margin="18,22">
                <TextBlock Text="OPEN" Foreground="#44D62C" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="SYNAPSE" Foreground="White" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="2.4-compatible control" Foreground="#7C837F" FontSize="11" Margin="0,4,0,26"/>
                <Button Content="⌂   Control panel" Click="DashboardNav_Click" HorizontalContentAlignment="Left"/>
                <Button Content="⚡   Game mode" Click="GameNav_Click" HorizontalContentAlignment="Left"/>
                <Button Content="⚙   Settings" Click="SettingsNav_Click" HorizontalContentAlignment="Left"/>
                <Button Content="≡   Diagnostics" Click="DiagnosticsNav_Click" HorizontalContentAlignment="Left"/>
                <Button Content="ⓘ   About" Click="AboutNav_Click" HorizontalContentAlignment="Left"/>
                <Border Margin="0,28,0,0" Padding="10" Background="#101411" BorderBrush="#29332A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Runtime health" Foreground="#8E9791" FontSize="11"/>
                        <TextBlock x:Name="HealthText" Text="Starting" Foreground="#44D62C" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid x:Name="TitleBar" Grid.Column="1" Margin="26,18,26,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OpenSynapse" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Windows power, display and Razer device control" Foreground="#A7ADA9" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="PowerText" Foreground="#44D62C" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="ModeText" Foreground="#C6CBC8" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Top">
                <Button Content="—" Width="34" Height="28" Padding="0" Click="Minimize_Click"/>
                <Button Content="□" Width="34" Height="28" Padding="0" Click="Maximize_Click"/>
                <Button Content="×" Width="34" Height="28" Padding="0" Click="CloseWindow_Click"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Grid.Column="1" Margin="26,0,26,0" Background="#090B0A" BorderBrush="#29312D">
            <TabItem Header="Control panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <GroupBox Header="Smart Auto status">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SmartReasonText" Text="Waiting for telemetry…" Foreground="#C6CBC8" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TelemetryText" Text="CPU / GPU / foreground unavailable" Foreground="#8E9791" Margin="0,8,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TemporaryText" Text="No temporary override" Foreground="#44D62C" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Razer DeathAdder V3 Pro">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="MouseText" Text="No supported mouse detected." Foreground="#C6CBC8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="DPI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="DpiBox" Text="1600" Width="90"/>
                                        <Button Content="Apply DPI" Margin="8,0,16,0" Click="ApplyDpi_Click"/>
                                        <TextBlock Text="Polling" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="PollingBox" Width="100" SelectedIndex="0">
                                            <ComboBoxItem Content="1000"/><ComboBoxItem Content="500"/><ComboBoxItem Content="125"/>
                                        </ComboBox>
                                        <Button Content="Apply" Margin="8,0,0,0" Click="ApplyPolling_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Top" Margin="12,0,0,0" Click="Refresh_Click"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Wake-armed devices (read-only)">
                            <TextBlock x:Name="WakeArmedText" Text="No wake-armed devices detected." Foreground="#C6CBC8" TextWrapping="Wrap"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Game mode">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <GroupBox Header="Operating mode">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Smart Auto" Click="Auto_Click"/>
                                    <Button Content="Hyper" Click="Performance_Click"/>
                                    <Button Content="Balance" Click="Balanced_Click"/>
                                    <Button Content="Quiet" Click="Quiet_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Auto combines trusted supply type, foreground apps and CPU/GPU load. It never promotes to Hyper on PD or battery." Foreground="#A7ADA9" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Temporary mode">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Hyper · 30 min" Click="TemporaryHyper_Click"/>
                                    <Button Content="Balance · 30 min" Click="TemporaryBalance_Click"/>
                                    <Button Content="Quiet · 30 min" Click="TemporaryQuiet_Click"/>
                                    <Button Content="Until power changes" Click="TemporaryUntilPower_Click"/>
                                    <Button Content="Cancel" Click="ClearTemporary_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Temporary modes do not change the persistent Auto/Hyper/Balance/Quiet selection." Foreground="#A7ADA9" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Application rules">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <TextBox x:Name="RuleProcessBox" Width="170" ToolTip="Process name, with or without .exe"/>
                                    <ComboBox x:Name="RuleProfileBox" Width="130"/>
                                    <ComboBox x:Name="RuleScopeBox" Width="130"/>
                                    <CheckBox x:Name="RuleEnabledCheck" Content="Enabled" IsChecked="True"/>
                                    <Button Content="Add / update" Click="AddRule_Click"/>
                                    <Button Content="Remove" Click="RemoveRule_Click"/>
                                </WrapPanel>
                                <TextBlock Grid.Row="1" Text="Rules are local, bounded and only match process names; no executable is launched or stopped by this editor." Foreground="#A7ADA9" Margin="0,8,0,8"/>
                                <TextBox Grid.Row="2" x:Name="RulesText" IsReadOnly="True" MinHeight="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <GroupBox Header="Display policy">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <CheckBox x:Name="ManageAdvancedColorCheck" Content="Manage HDR / Advanced Color"/>
                                    <CheckBox x:Name="ManageBrightnessCheck" Content="Manage internal brightness"/>
                                    <CheckBox x:Name="ManageScalingCheck" Content="Repair display scaling"/>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Internal scale" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="InternalScaleBox" Width="82"/>
                                    <TextBlock Text="External scale" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <ComboBox x:Name="ExternalScaleBox" Width="82"/>
                                </WrapPanel>
                                <WrapPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Balance brightness" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="BalancedBrightnessBox" Width="58"/>
                                    <TextBlock Text="Quiet brightness" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <TextBox x:Name="QuietBrightnessBox" Width="58"/>
                                    <TextBlock Text="Balance Hz" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <TextBox x:Name="BalancedRefreshBox" Width="58"/>
                                    <TextBlock Text="Quiet Hz" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <TextBox x:Name="QuietRefreshBox" Width="58"/>
                                </WrapPanel>
                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="Balance battery minimum" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="BalancedThresholdBox" Width="58" ToolTip="0-100 percent"/>
                                    </WrapPanel>
                                    <WrapPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Refresh policy" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="RefreshPolicyBox" Width="180"/>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Save settings" Click="SaveDisplayPolicy_Click"/>
                                        <Button Content="Apply display now · may blink" Click="ApplyDisplayNow_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Quiet maintenance">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <CheckBox x:Name="ManageWakeDevicesCheck" Content="Disable wake permission for exact allowlist while Quiet"/>
                                    <Button Content="Save Quiet settings" Click="SaveQuietMaintenance_Click"/>
                                </WrapPanel>
                                <TextBox Grid.Row="1" x:Name="QuietWakeDevicesBox" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            </Grid>
                        </GroupBox>
                        <TextBlock Text="OpenSynapse does not write Razer EC, set fan curves, set GPU TGP, or control MUX. DeathAdder V3 Pro changes use the supported HID feature-report path only." Foreground="#A7ADA9" TextWrapping="Wrap" Margin="0,4,0,20"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="0,14,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Run self-test" Click="SelfTest_Click"/>
                        <Button Content="Export diagnostics ZIP" Click="ExportDiagnostics_Click"/>
                        <Button Content="Refresh" Click="Refresh_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    <Button Grid.Row="2" Content="Restore captured state and exit" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Exit_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="OpenSynapse" FontSize="34" FontWeight="Bold" Foreground="#44D62C"/>
                    <TextBlock Text="PowerPilot 2.4.1 functionality and UI migrated under the OpenSynapse name." FontSize="16" Margin="0,10,0,0"/>
                    <TextBlock Text="Open-source Windows power, display and Razer HID control. Built around reversible state capture, read-only telemetry and bounded local IPC." Foreground="#A7ADA9" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <TextBlock Text="Safety boundary" Foreground="#44D62C" FontWeight="Bold" Margin="0,36,0,6"/>
                    <TextBlock Text="Power plan, brightness, HDR, scaling and wake-device changes are reversible. The Razer integration is limited to DeathAdder V3 Pro feature reports; no unsupported vendor driver or EC protocol is assumed." Foreground="#C6CBC8" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Grid.Column="1" Background="#101411" BorderBrush="#202A23" BorderThickness="1,0,0,0" Padding="26,0">
            <TextBlock Text="OpenSynapse · local user agent · display changes require explicit apply" Foreground="#7F8882" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
